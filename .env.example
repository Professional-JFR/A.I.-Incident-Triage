# Docker Compose defaults (copy this file to .env before starting the stack).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=incident_triage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Application settings
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600
RECENT_INCIDENT_LIMIT=50
STARTUP_DB_RETRIES=20
STARTUP_DB_RETRY_DELAY_SECONDS=1.5
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5

# Rule-based triage is the offline-safe default; configure an OpenAI-compatible
# chat-completions endpoint before setting TRIAGE_PROVIDER=llm.
TRIAGE_PROVIDER=rules
TRIAGE_LLM_ENDPOINT=
TRIAGE_LLM_API_KEY=
TRIAGE_LLM_MODEL=incident-triage
TRIAGE_LLM_TIMEOUT_SECONDS=5
TRIAGE_LLM_RETRIES=2
TRIAGE_LLM_RETRY_DELAY_SECONDS=0.25

# Optional API key authentication; set a strong secret when enabling.
API_KEY_AUTH_ENABLED=false
API_KEY=
AUTH_PROTECT_PUBLIC_ENDPOINTS=false

# Optional process-local rate limiting for POST /incidents/triage.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
